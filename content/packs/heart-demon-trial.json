{
  "schema_version": "0.2",
  "id": "pack.heart_demon_trial.zhuji.s001",
  "kind": "scene",
  "meta": {
    "title": "築基心魔",
    "summary": "突破築基時墜入心魔幻境，幻境地形取自玩家最常去的地圖，心魔化身成玩家最後悔辜負的人，台詞即時引用玩家過去的選擇。",
    "tags": [
      "心魔",
      "突破",
      "幻境",
      "個人化"
    ],
    "author": "director",
    "personalized_for": "save.001",
    "tier_range": {
      "min": "煉氣",
      "max": "築基"
    }
  },
  "trigger": {
    "all": [
      {
        "type": "tier_up",
        "to": "築基"
      }
    ],
    "once": true,
    "priority": 100
  },
  "requires_assets": [

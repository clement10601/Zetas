  "lore.concept.taiji": {
    "name": "太極生八卦",
    "kind": "concept",
    "summary": "易從太極生出陰陽兩儀，兩儀生四象，四象生八卦。陣法、五行術法、占卜的總綱。",
    "quote": {
      "text": "易有太極，是生兩儀，兩儀生四象，四象生八卦。",
      "source": "src.zhouyi",
      "chapter": "繫辭上",
      "verified": false
    },
    "tags": [
      "太極",
      "陰陽",
      "陣法"
    ],
    "hooks": {
      "uses": [
        "技能",
        "陣法"
      ],
      "idea": "技能樹可照這個層次分枝：一門功法分陰陽兩路，再分四象、八卦。"
    }
  },
  "lore.concept.bagua_pairs": {
    "name": "八卦相對",
    "kind": "concept",
    "summary": "天與地定上下之位，山與澤氣息相通，雷與風相互激盪，水與火不相厭棄。八卦兩兩成對。",
    "quote": {
      "text": "天地定位，山澤通氣，雷風相薄，水火不相射。",
      "source": "src.zhouyi",
      "chapter": "說卦傳",
      "verified": true
    },
    "tags": [
      "八卦",
      "相對"
    ],
    "hooks": {
      "uses": [
        "技能",
        "陣法"
      ],
      "idea": "八卦陣的機關：踩對兩兩相對的方位才能破陣。"
    }
  },
  "lore.concept.qian_lines": {
    "name": "乾卦六龍",
    "kind": "concept",
    "summary": "乾卦六爻以龍為喻：初九潛龍勿用，九五飛龍在天，上九亢龍有悔。時機未到要潛藏，到頂則必有悔。",
    "quote": {
      "text": "初九：潛龍勿用。",
      "source": "src.zhouyi",
      "chapter": "乾",
      "verified": true
    },
    "tags": [
      "龍",
      "時機",
      "境界"
    ],
    "hooks": {
      "uses": [
        "境界",
        "技能"
      ],
      "idea": "劍訣三段轉折節點可命名為潛龍、見龍、飛龍；修為到頂硬衝會「亢龍有悔」。"
    }
  },
  "lore.concept.daxiang_qian_kun": {
    "name": "自強不息，厚德載物",
    "kind": "concept",
    "summary": "乾卦大象：天道運行剛健，君子效法而自強不息。坤卦大象：地勢柔順，君子效法而以厚德承載萬物。",
    "quote": {
      "text": "天行健，君子以自強不息。",
      "source": "src.zhouyi",
      "chapter": "乾·象",
      "verified": true
    },
    "tags": [
      "宗門訓詞",
      "乾",
      "坤"
    ],
    "hooks": {
      "uses": [
        "對話"
      ],
      "idea": "青雲宗門規或傳功長老的訓詞。"
    }
  }
